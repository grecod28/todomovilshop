---
// ============================================================
// Sección "Blog": grid de últimas publicaciones.
// Datos de ejemplo: sustituye las rutas por las del CMS
// o colección de contenido cuando el blog sea real.
// ============================================================

interface Post {
	title: string;
	image: string;
	alt: string;
	date: string; // formato legible
	category: string;
	href: string; // enlace al artículo (placeholder)
}

const posts: Post[] = [
	{
		title: 'Gama Xiaomi Redmi Note en Ourense',
		image: '/images/2026073012462626252.webp',
		alt: 'Móvil de la gama Xiaomi Redmi Note expuesto en la tienda',
		date: '30 de julio de 2026',
		category: 'Xiaomi',
		href: '#',
	},
	{
		title: 'Vuelta al cole: gadgets tecnológicos imprescindibles',
		image: '/images/2025082718530456306.jpg',
		alt: 'Gadgets tecnológicos para la vuelta al cole',
		date: '27 de agosto de 2026',
		category: 'Consejos',
		href: '#',
	},
	{
		title: 'Smartband o smartwatch: ¿cuál elegir?',
		image: '/images/2026082713071561774.jpg',
		alt: 'Comparativa entre smartband y smartwatch',
		date: '12 de agosto de 2026',
		category: 'Wearables',
		href: '#',
	},
	{
		title: 'Primer móvil para un niño: edad recomendada',
		image: '/images/2026073013392884773.jpg',
		alt: 'Niño sujetando su primer teléfono móvil',
		date: '30 de julio de 2026',
		category: 'Consejos',
		href: '#',
	},
	{
		title: 'Protector de hidrogel para móvil, ¿dónde ponerlo?',
		image: '/images/2026073013392944277.jpg',
		alt: 'Colocación de un protector de hidrogel en un smartphone',
		date: '18 de julio de 2026',
		category: 'Accesorios',
		href: '#',
	},
	{
		title: 'Cómo elegir la mejor tarifa móvil sin pagar de más',
		image: '/images/2022041913174977471.jpg',
		alt: 'Persona comparando tarifas de telefonía móvil',
		date: '5 de julio de 2026',
		category: 'Tarifas',
		href: '#',
	},
];
---

<section class="section" id="blog">
	<div class="container">
		<div class="section__header reveal">
			<span class="section__eyebrow">Blog</span>
			<h2 class="section__title">Últimas publicaciones</h2>
			<p class="section__subtitle">
				Consejos, novedades y guías para sacar el máximo partido a tu móvil.
			</p>
		</div>

		<div class="blog__grid">
			{posts.map((post, i) => (
				<article class="card blog__card reveal" data-delay={String(i % 3)}>
					<a class="blog__media" href={post.href} aria-label={`Leer artículo: ${post.title}`}>
						<img src={post.image} alt={post.alt} loading="lazy" width="640" height="420" />
					</a>
					<div class="blog__body">
						<div class="blog__meta">
							<span class="blog__category">{post.category}</span>
							<time class="blog__date" datetime={post.date}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M8 2v4M16 2v4"></path>
									<rect x="3" y="4" width="18" height="18" rx="2"></rect>
									<path d="M3 10h18"></path>
								</svg>
								{post.date}
							</time>
						</div>
						<h3 class="blog__title">
							<a href={post.href}>{post.title}</a>
						</h3>
						<a class="blog__more" href={post.href}>
							Leer más
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M5 12h14"></path>
								<path d="m12 5 7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.blog__grid {
		display: grid;
		gap: 1.5rem;
	}

	.blog__card {
		overflow: hidden; /* recorta la imagen con el borde redondeado */
		display: flex;
		flex-direction: column;
	}

	/* Imagen con zoom suave al hover */
	.blog__media {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
	}

	.blog__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s var(--ease);
	}

	.blog__card:hover .blog__media img {
		transform: scale(1.06);
	}

	.blog__body {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		padding: 1.4rem 1.5rem 1.5rem;
	}

	.blog__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.8rem;
	}

	/* Chip de categoría */
	.blog__category {
		padding: 0.25rem 0.8rem;
		border-radius: 999px;
		background: var(--color-bg-soft);
		color: var(--color-blue-violet);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.blog__date {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-text-soft);
		font-size: 0.8rem;
	}

	.blog__date svg {
		width: 14px;
		height: 14px;
	}

	.blog__title {
		font-size: 1.05rem;
		line-height: 1.4;
		margin-bottom: 1rem;
		flex-grow: 1;
	}

	.blog__title a {
		color: var(--color-text);
	}

	.blog__title a:hover {
		color: var(--color-blue);
	}

	.blog__more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-blue);
	}

	.blog__more svg {
		width: 15px;
		height: 15px;
		transition: transform var(--speed) var(--ease);
	}

	.blog__more:hover {
		color: var(--color-blue-violet);
	}

	.blog__more:hover svg {
		transform: translateX(4px);
	}

	/* ============================================================
	   Responsive
	   ============================================================ */
	@media (min-width: 768px) {
		.blog__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.blog__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
