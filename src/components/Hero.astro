---
// ============================================================
// Hero principal: titular, subtítulo, CTAs e ilustración
// SVG de un smartphone con gradiente corporativo.
// ============================================================
---

<section class="hero" id="inicio">
	<!-- Decoración de fondo: círculos degradados -->
	<div class="hero__bg" aria-hidden="true">
		<span class="hero__blob hero__blob--1"></span>
		<span class="hero__blob hero__blob--2"></span>
	</div>

	<div class="container hero__grid">
		<div class="hero__content">
			<span class="hero__badge">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				Ourense · Centro
			</span>

			<h1>Tu tienda de <span class="gradient-text">telefonía</span> en Ourense</h1>

			<p class="hero__lead">
				En TodoMóvilShop contamos con las mejores marcas de móviles y el mejor
				servicio post-venta en Ourense.
			</p>

			<div class="hero__actions">
				<a class="btn btn--primary" href="#contacto">
					Contactar ahora
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
				<a class="btn btn--ghost" href="#servicios">Ver servicios</a>
			</div>

			<!-- Puntos de confianza -->
			<ul class="hero__trust">
				<li>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 6 9 17l-5-5"></path>
					</svg>
					Reparaciones en horas
				</li>
				<li>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 6 9 17l-5-5"></path>
					</svg>
					Punto oficial Xiaomi
				</li>
				<li>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 6 9 17l-5-5"></path>
					</svg>
					Mejores precios
				</li>
			</ul>
		</div>

		<!-- Ilustración: smartphone SVG con tarjetas flotantes -->
		<div class="hero__media">
			<svg class="hero__phone" viewBox="0 0 420 520" role="img" aria-label="Ilustración de un teléfono móvil con la marca TodoMóvilShop">
				<defs>
					<linearGradient id="screenGrad" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" stop-color="#42A8DC"></stop>
						<stop offset="0.55" stop-color="#3F90CE"></stop>
						<stop offset="1" stop-color="#4564AD"></stop>
					</linearGradient>
					<linearGradient id="tileGrad" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
						<stop offset="1" stop-color="#ffffff" stop-opacity="0.85"></stop>
					</linearGradient>
				</defs>

				<!-- Cuerpo del teléfono -->
				<rect x="92" y="16" width="236" height="488" rx="38" fill="#1A1A1A"></rect>
				<rect x="98" y="22" width="224" height="476" rx="33" fill="#23262B"></rect>

				<!-- Pantalla -->
				<rect x="106" y="30" width="208" height="460" rx="26" fill="url(#screenGrad)"></rect>

				<!-- Notch -->
				<rect x="182" y="38" width="56" height="14" rx="7" fill="#1A1A1A" opacity="0.4"></rect>

				<!-- Saludo -->
				<text x="130" y="98" font-family="Poppins, sans-serif" font-size="19" font-weight="700" fill="#ffffff">Hola 👋</text>
				<text x="130" y="120" font-family="Poppins, sans-serif" font-size="12" fill="#ffffff" opacity="0.85">Bienvenido a TodoMóvilShop</text>

				<!-- Tarjetas de app (fila 1) -->
				<rect x="130" y="146" width="76" height="76" rx="18" fill="url(#tileGrad)"></rect>
				<rect x="216" y="146" width="76" height="76" rx="18" fill="url(#tileGrad)"></rect>
				<!-- Icono teléfono -->
				<path d="M150 184h36M154 170h5" stroke="#3F90CE" stroke-width="3" stroke-linecap="round"></path>
				<!-- Icono carrito -->
				<circle cx="240" cy="180" r="7" fill="none" stroke="#4564AD" stroke-width="3"></circle>
				<path d="M244 186l9-2 6 12h-19z" stroke="#4564AD" stroke-width="3" stroke-linejoin="round"></path>

				<!-- Tarjetas de app (fila 2) -->
				<rect x="130" y="232" width="76" height="76" rx="18" fill="url(#tileGrad)"></rect>
				<rect x="216" y="232" width="76" height="76" rx="18" fill="url(#tileGrad)"></rect>
				<!-- Icono llave inglesa -->
				<path d="M158 264l6 6 8-8a9 9 0 1 1 7 3l-6 6-4-3z" stroke="#42A8DC" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
				<!-- Icono etiqueta precio -->
				<path d="M244 256l16 16-16 16" stroke="#3F90CE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
				<circle cx="256" cy="272" r="3.5" fill="#3F90CE"></circle>

				<!-- Tarjeta destacada: logo T -->
				<rect x="130" y="318" width="162" height="104" rx="20" fill="#ffffff" opacity="0.18"></rect>
				<text x="211" y="382" text-anchor="middle" font-family="Poppins, sans-serif" font-size="46" font-weight="700" fill="#ffffff">T</text>
			</svg>

			<!-- Tarjetas flotantes sobre la ilustración -->
			<div class="hero__chip hero__chip--1">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
					<path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"></path>
				</svg>
				<span><strong>Reparación exprés</strong><small>Móvil listo en horas</small></span>
			</div>
			<div class="hero__chip hero__chip--2">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
					<path d="M3 6h18"></path>
					<path d="M16 10a4 4 0 0 1-8 0"></path>
				</svg>
				<span><strong>Tienda oficial</strong><small>Xiaomi en Ourense</small></span>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: calc(var(--header-height) + 3.5rem) 0 5.5rem;
	}

	/* Fondos decorativos */
	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(600px 400px at 85% 10%, rgba(66, 168, 220, 0.14), transparent 70%),
			radial-gradient(500px 380px at 5% 90%, rgba(69, 100, 173, 0.12), transparent 70%);
	}

	.hero__blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
		opacity: 0.35;
	}

	.hero__blob--1 {
		width: 380px;
		height: 380px;
		background: var(--color-cyan);
		top: -140px;
		right: -100px;
	}

	.hero__blob--2 {
		width: 320px;
		height: 320px;
		background: var(--color-blue-violet);
		bottom: -140px;
		left: -120px;
	}

	.hero__grid {
		display: grid;
		gap: 3rem;
		align-items: center;
	}

	/* ---------- Contenido ---------- */
	.hero__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 1rem;
		border-radius: 999px;
		background: var(--color-bg-soft);
		color: var(--color-blue-violet);
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 1.4rem;
	}

	.hero__badge svg {
		width: 16px;
		height: 16px;
	}

	h1 {
		font-size: clamp(2.2rem, 5.5vw, 3.4rem);
		font-weight: 700;
		color: var(--color-blue-violet);
		margin-bottom: 1.1rem;
	}

	/* Palabra destacada con gradiente */
	.gradient-text {
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__lead {
		font-size: 1.1rem;
		color: var(--color-text-soft);
		max-width: 480px;
		margin-bottom: 2rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-bottom: 2.2rem;
	}

	.hero__actions svg {
		width: 18px;
		height: 18px;
	}

	/* Puntos de confianza */
	.hero__trust {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
	}

	.hero__trust li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.hero__trust svg {
		width: 16px;
		height: 16px;
		color: var(--color-blue);
	}

	/* ---------- Ilustración ---------- */
	.hero__media {
		position: relative;
		max-width: 420px;
		margin-inline: auto;
		width: 100%;
	}

	.hero__phone {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 30px 40px rgba(69, 100, 173, 0.28));
	}

	/* Tarjetas flotantes */
	.hero__chip {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.8rem 1.1rem;
		background: #fff;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
	}

	.hero__chip svg {
		width: 26px;
		height: 26px;
		color: var(--color-blue);
	}

	.hero__chip strong,
	.hero__chip small {
		display: block;
		line-height: 1.3;
	}

	.hero__chip strong {
		font-size: 0.9rem;
		color: var(--color-text);
	}

	.hero__chip small {
		font-size: 0.78rem;
		color: var(--color-text-soft);
	}

	.hero__chip--1 {
		top: 12%;
		left: -8%;
	}

	.hero__chip--2 {
		bottom: 14%;
		right: -6%;
	}

	/* ============================================================
	   Responsive
	   ============================================================ */

	/* Tablet: dos columnas */
	@media (min-width: 768px) {
		.hero__grid {
			grid-template-columns: 1.05fr 0.95fr;
		}
	}

	/* Móvil: chips pegados a los bordes */
	@media (max-width: 767px) {
		.hero {
			padding-top: calc(var(--header-height) + 2.5rem);
		}

		.hero__content {
			text-align: center;
		}

		.hero__lead {
			margin-inline: auto;
		}

		.hero__actions {
			justify-content: center;
		}

		.hero__trust {
			justify-content: center;
		}

		.hero__chip--1 {
			left: -4%;
			top: 6%;
		}

		.hero__chip--2 {
			right: -4%;
			bottom: 8%;
		}
	}
</style>
