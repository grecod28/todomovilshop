---
// ============================================================
// Sección "La tienda": fotografía del local con marco
// decorativo y placa flotante con la dirección.
// ============================================================
---

<section class="section tienda" id="tienda">
	<div class="container">
		<div class="section__header reveal">
			<span class="section__eyebrow">La tienda</span>
			<h2 class="section__title">Así es TodoMóvilShop</h2>
			<p class="section__subtitle">
				Visítanos en pleno centro de Ourense y descubre todo lo que tenemos
				preparado para ti.
			</p>
		</div>

		<figure class="tienda__media reveal" data-delay="1">
			<img
				src="/images/2026073013464972340.jpg"
				alt="Exterior de la tienda TodoMóvilShop en Ourense"
				loading="lazy"
				width="1200"
				height="675"
			/>
			<figcaption class="tienda__badge">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				<span>
					<strong>TodoMóvilShop</strong>
					<small>Rúa Santo Domingo 64 · Ourense</small>
				</span>
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.tienda {
		padding-top: calc(var(--header-height) + 2.5rem);
	}

	.tienda__media {
		position: relative;
		margin: 0 auto;
		max-width: 1100px;
	}

	.tienda__media img {
		width: 100%;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		object-fit: cover;
		aspect-ratio: 16 / 9;
	}

	/* Placa flotante con la dirección */
	.tienda__badge {
		position: absolute;
		left: 1.4rem;
		bottom: -1.4rem;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.9rem 1.3rem;
		background: #fff;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
	}

	.tienda__badge svg {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		color: var(--color-blue);
	}

	.tienda__badge strong,
	.tienda__badge small {
		display: block;
		line-height: 1.3;
	}

	.tienda__badge strong {
		font-family: var(--font-heading);
		font-size: 1rem;
		color: var(--color-blue-violet);
	}

	.tienda__badge small {
		font-size: 0.82rem;
		color: var(--color-text-soft);
	}

	/* ============================================================
	   Responsive
	   ============================================================ */
	@media (max-width: 767px) {
		.tienda__badge {
			left: 50%;
			transform: translateX(-50%);
			white-space: nowrap;
		}
	}
</style>
