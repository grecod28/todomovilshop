---
// ============================================================
// Sección "Cómo llegar / Ubicación":
// dirección, cita previa por teléfono/WhatsApp y mapa embebido.
// ============================================================

const telefono = '619 522 906';
const telefonoUrl = 'tel:+34619522906';
const whatsappUrl = 'https://wa.me/34619522906';
---

<section class="section section--alt" id="ubicacion">
	<div class="container">
		<div class="section__header reveal">
			<span class="section__eyebrow">Cómo llegar</span>
			<h2 class="section__title">Visítanos en el centro de Ourense</h2>
		</div>

		<div class="ubicacion__grid">
			<!-- Información de la tienda -->
			<div class="card ubicacion__info reveal">
				<h3>Dónde estamos</h3>
				<p>
					Puedes visitarnos en Ourense en
					<strong>Rúa Santo Domingo, Nº 64</strong>, Galerías Comerciales
					Santo Domingo.
				</p>

				<!-- Cita previa -->
				<div class="ubicacion__cita">
					<h4>Cita previa</h4>
					<p>
						Para evitar esperas, pide tu cita previa por teléfono o
						WhatsApp y te atendemos a la hora que mejor te venga.
					</p>
					<div class="ubicacion__actions">
						<a class="btn btn--ghost" href={telefonoUrl}>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							{telefono}
						</a>
						<a class="btn btn--whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.93L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.77 14.06c-.24.68-1.4 1.3-1.94 1.35-.52.05-1.17.24-3.94-.82-3.33-1.31-5.43-4.7-5.6-4.92-.16-.22-1.33-1.77-1.33-3.38 0-1.6.84-2.39 1.14-2.72.3-.33.65-.41.87-.41h.62c.2 0 .47-.08.73.55.27.65.9 2.24.98 2.4.08.16.14.36.03.58-.11.22-.17.36-.33.55-.16.19-.35.43-.5.57-.16.17-.34.35-.15.68.2.33.87 1.43 1.87 2.32 1.28 1.14 2.36 1.5 2.7 1.67.33.16.53.13.72-.08.2-.22.84-.98 1.06-1.31.22-.33.44-.27.74-.16.3.1 1.93.9 2.26 1.07.33.16.55.25.63.38.08.14.08.8-.16 1.48Z"></path>
							</svg>
							WhatsApp
						</a>
					</div>
				</div>

				<ul class="ubicacion__detalles">
					<li>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
						<span>Rúa Santo Domingo, Nº 64<br />Galerías Comerciales Santo Domingo, 32003 Ourense</span>
					</li>
					<li>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M12 6v6l4 2"></path>
						</svg>
						<span>Horario: de lunes a sábado</span>
					</li>
				</ul>
			</div>

			<!-- Mapa embebido de Google Maps (sin API key) -->
			<div class="ubicacion__mapa reveal" data-delay="1">
				<iframe
					src="https://www.google.com/maps?q=R%C3%BAa%20Santo%20Domingo%2064%2C%20Ourense&output=embed"
					title="Mapa con la ubicación de TodoMóvilShop en Rúa Santo Domingo 64, Ourense"
					loading="lazy"
					allowfullscreen
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</div>
		</div>
	</div>
</section>

<style>
	.ubicacion__grid {
		display: grid;
		gap: 2rem;
		align-items: stretch;
	}

	.ubicacion__info {
		padding: 2.2rem 1.8rem;
	}

	.ubicacion__info h3 {
		font-size: 1.35rem;
	}

	.ubicacion__cita {
		margin: 1.5rem 0;
		padding: 1.4rem 1.5rem;
		background: var(--color-bg);
		border-radius: var(--radius-md);
	}

	.ubicacion__cita h4 {
		font-size: 1rem;
		margin-bottom: 0.4rem;
	}

	.ubicacion__cita p {
		font-size: 0.92rem;
		color: var(--color-text-soft);
		margin-bottom: 1rem;
	}

	.ubicacion__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	.ubicacion__actions svg {
		width: 17px;
		height: 17px;
	}

	/* Lista de detalles con iconos */
	.ubicacion__detalles {
		display: grid;
		gap: 0.9rem;
	}

	.ubicacion__detalles li {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		color: var(--color-text-soft);
		font-size: 0.95rem;
	}

	.ubicacion__detalles svg {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		color: var(--color-blue);
		margin-top: 0.2rem;
	}

	/* Mapa embebido responsive */
	.ubicacion__mapa {
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-md);
		min-height: 320px;
	}

	.ubicacion__mapa iframe {
		width: 100%;
		height: 100%;
		min-height: 320px;
		border: 0;
	}

	/* ============================================================
	   Responsive
	   ============================================================ */
	@media (min-width: 1024px) {
		.ubicacion__grid {
			grid-template-columns: 1fr 1.1fr;
		}

		.ubicacion__mapa {
			min-height: 480px;
		}

		.ubicacion__mapa iframe {
			min-height: 480px;
		}
	}
</style>
